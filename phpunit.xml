<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="AI_PROVIDER_RUNTIME" value="fake"/>
        <env name="AI_PRIMARY_PROVIDER" value="openai"/>
        <env name="AI_REVIEWER_PROVIDER" value="anthropic"/>
        <env name="AI_ADJUDICATOR_PROVIDER" value="gemini"/>
        <!-- Bloqueio do painel sem assinatura: ligado só nos testes dele
             (SubscriptionAccessEnforcementTest) — as demais clínicas de teste
             nascem sem plano ativo, logo sem trial. -->
        <env name="BILLING_ENFORCE_SUBSCRIPTION_ACCESS" value="false"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Senhas fixas dos seeders e código do WhatsApp simulado: só em
             dev local e nos testes automatizados (a homologação também roda
             APP_ENV=testing, mas sem estas chaves). -->
        <env name="SEED_FIXED_CREDENTIALS" value="true"/>
        <env name="WHATSAPP_MOCK_REQUIRES_CODE" value="true"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="FILESYSTEM_DISK" value="local"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="DB_DATABASE" value="easyeye_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
