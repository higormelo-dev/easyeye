APP_NAME=EasyEye
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
# Em produção: defina o domínio HTTPS completo. Ex.: https://teste.easyeye.app
# O Laravel usa essa variável quando não há request HTTP (jobs, CLI, e-mails)
# e como fallback se o X-Forwarded-Host do proxy não estiver disponível.
APP_URL=http://localhost:8085

# Senhas FIXAS do repositório nos seeders (Clínica Teste Integrador, admins
# do SaaS): só em APP_ENV=local ou com esta chave = true (o phpunit.xml liga
# para os testes automatizados). Homologação (APP_ENV=testing!) e produção:
# deixe false — os seeders geram senha aleatória e mostram UMA vez no
# terminal. Em produção a chave é ignorada.
SEED_FIXED_CREDENTIALS=false

# Em produção atrás de proxy (SaveInCloud, Cloudflare, etc.), o trustProxies
# em bootstrap/app.php já força esquema https via X-Forwarded-Proto e o
# AppServiceProvider executa URL::forceScheme('https') quando APP_ENV=production.
# Não é necessária variável extra para forçar HTTPS — basta APP_ENV correto.

# Porta do Vite dev server (node container) — deve bater com VITE_PORT no .env
SERVER_PORT=8085
VITE_PORT=5173

# ──────────────────────────────────────────────────────────────────────────────
# Docker user mapping
# ──────────────────────────────────────────────────────────────────────────────
# UID/GID do host (não-root). Usados pelo docker-compose para:
#   - Build da imagem (args APP_USER/UID/GID no Dockerfile criam o user interno)
#   - Service `node` rodar como mesmo UID do host para gravar `public/hot` com
#     permissão correta. Sem isso, Laravel não consegue ler o hot file e cai
#     no fallback de assets buildados (sintoma: "assets sempre antigos").
# Ajuste se seu usuário tem UID diferente de 1000:  `id -u` e `id -g` no terminal.
APP_USER=easyeye
UID=1000
GID=1000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Identidade do proprietário do SaaS — fallback de localização em PDFs
# quando a clínica não preencher city/state/country.
SAAS_OWNER_NAME="${APP_NAME}"
SAAS_OWNER_CITY=
SAAS_OWNER_STATE=
SAAS_OWNER_COUNTRY=BR
SAAS_OWNER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------
# BANCO DE DADOS
# ------------------------------------------------------------
# Opção A — Docker (PostgreSQL no host Ubuntu, acessado via host-gateway)
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=easyeye
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Opção B — Desenvolvimento local sem Docker (descomente e comente a opção A)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=easyeye
# DB_USERNAME=postgres
# DB_PASSWORD=

# Opção C — SQLite para testes rápidos / CI (descomente e comente a opção A)
# DB_CONNECTION=sqlite
# ------------------------------------------------------------

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# Queue: redis para produção/docker | database para dev sem Redis
QUEUE_CONNECTION=redis
# QUEUE_CONNECTION_DOCKER usada pelo docker-compose para sobrescrever se necessário
QUEUE_CONNECTION_DOCKER=redis
# Precisa ser MAIOR que o maior $timeout dos jobs (importações: 900 s;
# WhatsApp: 150 s) — senão o job é entregue a outro worker no meio.
# REDIS_QUEUE_RETRY_AFTER=960

CACHE_STORE=redis
CACHE_PREFIX=easyeye_

MEMCACHED_HOST=127.0.0.1

# ------------------------------------------------------------
# REDIS
# Cada contexto usa um DB separado para evitar colisão de chaves.
#
# DB 0 — default (conexões gerais, filas)
# DB 1 — cache
# DB 3 — sessões
#
# Opção A — Docker (Redis no host Ubuntu, acessado via host-gateway)
REDIS_CLIENT=phpredis
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=null
REDIS_PORT=6379

# Opção B — Desenvolvimento local sem Docker (descomente e comente a opção A)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# ------------------------------------------------------------

REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=3
REDIS_SESSION_CONNECTION=session

# ------------------------------------------------------------
# MAIL
# ------------------------------------------------------------
MAIL_MAILER=log
# O formulário público usa SMTP diretamente, sem fallback para logs.
MAIL_CONTACT_ADDRESS=contato@easyeye.app
MAIL_SUPPORT_ADDRESS=suporte@easyeye.app
# A identificação pública e os contatos dos documentos estão em config/legal.php.
# Sobrescreva somente antes da publicação de uma nova versão do documento.
# LEGAL_CONTROLLER_NAME=
# LEGAL_CONTROLLER_CNPJ=
# LEGAL_CONTROLLER_ADDRESS=
# LEGAL_PRIVACY_EMAIL=contato@easyeye.app
# LEGAL_PRIVACY_PHONE="+55 61 98467-6485"
# LEGAL_TERMS_EMAIL=contato@easyeye.app
# LEGAL_TERMS_PHONE="+55 61 98467-6485"
MAIL_TIMEOUT=10
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@easyeye.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
# AWS / STORAGE
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# Inertia SSR
# Ligue em produção quando o daemon SSR estiver ativo (Supervisor/PM2).
INERTIA_SSR_ENABLED=true
INERTIA_SSR_RUNTIME=node
INERTIA_SSR_ENSURE_RUNTIME_EXISTS=true
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=true
# Em produção, mantenha false para fallback automático em caso de falha SSR.
INERTIA_SSR_THROW_ON_ERROR=false
# Docker compose com service "ssr": http://ssr:13714
# SaveinCloud com Node addon no mesmo servidor da app: http://127.0.0.1:13714
INERTIA_SSR_URL=http://ssr:13714

# ------------------------------------------------------------
# PDF — wkhtmltopdf via barryvdh/laravel-snappy
# Binário instalado pelo Dockerfile (.deb oficial Bookworm)
# ------------------------------------------------------------
WKHTML_PDF_BINARY=/usr/local/bin/wkhtmltopdf
WKHTML_IMG_BINARY=/usr/local/bin/wkhtmltoimage

# ------------------------------------------------------------
# SENTRY
# ------------------------------------------------------------
SENTRY_LARAVEL_DSN=

# ------------------------------------------------------------
# SEEDS — dados fake para desenvolvimento/testes
# ------------------------------------------------------------
SEED_FAKE_PEOPLE=2200
SEED_FAKE_ENTITIES=12
SEED_FAKE_USERS=80
SEED_FAKE_DOCTORS=140
SEED_FAKE_SCHEDULE_BATCH_SIZE=2000
SEED_FAKE_SCHEDULE_PAST_MONTHS=1
SEED_FAKE_SCHEDULE_FUTURE_MONTHS=2

# ------------------------------------------------------------
# BILLING MULTI-GATEWAY
# ------------------------------------------------------------
BILLING_DEFAULT_GATEWAY=asaas
# false libera o painel de clínicas sem assinatura com acesso (chave de emergência)
BILLING_ENFORCE_SUBSCRIPTION_ACCESS=true
# Vencimento da 1ª cobrança (dias após contratar) e antecedência da cobrança de renovação local
BILLING_FIRST_CHARGE_DUE_DAYS=3
BILLING_RENEWAL_LEAD_DAYS=5
# Régua de cobrança: false desliga avisos, encerramento e cancelamento no gateway (chave de emergência)
BILLING_DUNNING_ENABLED=true
# Régua de cobrança (dias): lembrete antes do vencimento; acesso limitado e encerramento após o vencimento
BILLING_DUNNING_REMINDER_DAYS_BEFORE=5
BILLING_DUNNING_SOFT_BLOCK_AFTER_DAYS=3
BILLING_DUNNING_HARD_BLOCK_AFTER_DAYS=7
# Fim do teste grátis (billing:trial-notices): e-mail + WhatsApp 3 dias antes, 1 dia antes e no dia
BILLING_TRIAL_NOTICES_ENABLED=true
# Avisos do SaaS à clínica também pelo WhatsApp (app GLOBAL do EasyEye, templates), só em horário comercial (fuso do app)
BILLING_NOTICES_WHATSAPP_ENABLED=true
BILLING_NOTICES_WHATSAPP_START=08:00
BILLING_NOTICES_WHATSAPP_END=20:00
# "Enviar cobrança à clínica" (manager): um envio por fatura a cada N minutos
BILLING_CHARGE_NOTICE_COOLDOWN_MINUTES=10
BILLING_WEBHOOK_QUEUE=default
# Dias que os webhooks PROCESSADOS ficam guardados (billing:prune-webhook-events)
BILLING_WEBHOOK_RETENTION_DAYS=90
# Limite da rota pública de webhook POR GATEWAY (não por IP: 429 pausa a fila do Asaas)
BILLING_WEBHOOK_RATE_LIMIT_PER_MINUTE=3000
# Conciliação diária (billing:reconcile-overdue): teto por execução, pausa entre consultas (ms) e até quantos dias de atraso
BILLING_RECONCILE_MAX_PER_RUN=100
BILLING_RECONCILE_PAUSE_MS=300
BILLING_RECONCILE_LOOKBACK_DAYS=60
BILLING_PAYMENT_RETRY_MAX_ATTEMPTS=3
BILLING_PAYMENT_RETRY_BACKOFF_SECONDS=120
BILLING_CIRCUIT_BREAKER_THRESHOLD=5
BILLING_CIRCUIT_BREAKER_COOLDOWN=300
# Checkout transparente: parcelas sem juros no cartão (ciclo anual) e parcela mínima (R$)
BILLING_CHECKOUT_MAX_INSTALLMENTS=12
BILLING_CHECKOUT_MIN_INSTALLMENT_AMOUNT=5
BILLING_CHECKOUT_IDEMPOTENCY_MINUTES=30
BILLING_CHECKOUT_FIRST_CHARGE_GRACE_COOLDOWN_DAYS=30
BILLING_CHECKOUT_MIN_PRORATION_AMOUNT=5
# Antifraude do checkout (recusas de cartão) e do cadastro
BILLING_CHECKOUT_DECLINES_PER_IP_HOUR=3
BILLING_CHECKOUT_DECLINES_PER_IP_DAY=6
BILLING_CHECKOUT_DECLINES_PER_ENTITY_DAY=5
BILLING_CHECKOUT_SIGNUP_DECLINES_GLOBAL_HOUR=20
BILLING_CHECKOUT_PANEL_DECLINES_GLOBAL_HOUR=60
BILLING_CHECKOUT_SIGNUP_UNVERIFIED_DECLINES=1
BILLING_REGISTER_PER_IP_HOUR=10
BILLING_REGISTER_PER_IP_DAY=30
# CSP das telas de pagamento (Minha assinatura, tela de IA, /subscription/expired, /register): enforce | report-only | off
BILLING_CHECKOUT_CSP=enforce
# Cloudflare Turnstile no /register — ligado só com as duas chaves
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# InfinitePay (Checkout Integrado): sem token — a loja é a InfiniteTag (sem "$").
# Sem assinatura no webhook: o pagamento é confirmado no payment_check.
INFINITEPAY_HANDLE=
INFINITEPAY_CHECKOUT_BASE_URL=https://api.checkout.infinitepay.io
# Para onde o cliente volta depois de pagar (https). Opcional.
INFINITEPAY_REDIRECT_URL=
# Vazio = rota /api/billing/webhooks/infinitepay deste APP_URL (precisa ser https).
INFINITEPAY_WEBHOOK_URL=

# Asaas. Sandbox: ASAAS_BASE_URL=https://api-sandbox.asaas.com
ASAAS_BASE_URL=https://api.asaas.com
# A chave começa com "$aact_": use aspas simples (senão o "$" vira variável).
ASAAS_SECRET=''
# Token do webhook (asaas-access-token): 32 a 255 caracteres, o mesmo cadastrado no painel do Asaas.
ASAAS_WEBHOOK_SECRET=
# UNDEFINED (cliente escolhe boleto/Pix/cartão), BOLETO, PIX ou CREDIT_CARD.
ASAAS_BILLING_TYPE=UNDEFINED
# Cartão pelo Asaas Checkout (página hospedada); false = link da fatura. Validade do checkout: 10 a 1440 min.
ASAAS_HOSTED_CHECKOUT=true
ASAAS_CHECKOUT_MINUTES_TO_EXPIRE=60
# PNG/JPG do item do checkout (imageBase64) — só se o Asaas exigir. Guia: docs/billing/asaas-configuracao.md
ASAAS_CHECKOUT_ITEM_IMAGE=

# Mercado Pago: Access Token (APP_USR-...) e a "assinatura secreta" do webhook.
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
# Chave pública do MercadoPago.js (vai ao navegador)
MERCADOPAGO_PUBLIC_KEY=

# Pagar.me: secret key (sk_...) e Basic Auth do webhook no formato usuario:senha.
PAGARME_BASE_URL=https://api.pagar.me/core/v5
PAGARME_SECRET=
PAGARME_WEBHOOK_SECRET=
# Chave pública (pk_…) do tokenizecard.js (vai ao navegador)
PAGARME_PUBLIC_KEY=
# pix ou boleto (boleto exige endereço completo da empresa).
PAGARME_PAYMENT_METHOD=pix

# Stripe: secret key (sk_...) e signing secret do endpoint de webhook (whsec_...).
STRIPE_BR_BASE_URL=https://api.stripe.com
STRIPE_BR_SECRET=
STRIPE_BR_WEBHOOK_SECRET=
# Publishable key (pk_…) do Stripe.js (vai ao navegador)
STRIPE_BR_PUBLISHABLE_KEY=
STRIPE_BR_API_VERSION=2025-03-31.basil

# PagBank: token da conta (o mesmo valida a assinatura x-authenticity-token do webhook).
PAGBANK_BASE_URL=https://api.pagseguro.com
PAGBANK_SECRET=
PAGBANK_WEBHOOK_SECRET=
# Chave pública do PagSeguro.encryptCard (vazia = obtida pela API e guardada em cache)
PAGBANK_PUBLIC_KEY=
# Vazio = rota /api/billing/webhooks/pagbank deste APP_URL (precisa ser https).
PAGBANK_NOTIFICATION_URL=

# ------------------------------------------------------------
# AI PROVIDERS
# ------------------------------------------------------------
# Chaves de API: SÓ aqui (nunca no banco). Basta a chave para o provedor
# aparecer como "Configurado" em Manager -> Provedores de IA. Papéis
# (principal/revisor/árbitro) e o modelo de cada provedor são escolhidos no
# painel e ficam no banco — sem deploy. Deixe vazia a chave de quem não usa.
# Depois de mudar o .env: php artisan config:cache e php artisan queue:restart.
# LGPD (docs/legal/ai-providers-lgpd.md): a Gemini API não recebe dado de
# paciente (fora dos papéis do assistente); quem processa fora do Brasil sem
# adequação exige o mecanismo de transferência registrado no painel.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
AZURE_OPENAI_API_KEY=
MARITACA_API_KEY=

# Azure OpenAI: sem endereço padrão (um por recurso) — obrigatório com a chave.
# Deployment Standard regional em swedencentral (UE) com o nome do modelo.
# AI_AZURE_OPENAI_DATA_REGION: eu (Standard regional na UE), br (Provisioned em
# brazilsouth) ou global (Global/Data Zone — exige registro de transferência).
AI_AZURE_OPENAI_BASE_URL=
# AI_AZURE_OPENAI_MODEL=gpt-4o-mini
# AI_AZURE_OPENAI_DATA_REGION=eu

# fake = respostas simuladas (dev/testes); real = chama os provedores de verdade.
AI_PROVIDER_RUNTIME=fake
AI_DEFAULT_MODE=validated
AI_ENABLE_CONSENSUS=true

# User-Agent enviado aos provedores LLM. Identifica EasyEye em logs/abuse
# reports do fornecedor. Inclua URL de contato para facilitar debug entre times.
AI_USER_AGENT="EasyEye/1.0 (+https://easyeye.com.br)"

# Catálogo de modelos e preços (Manager -> Provedores de IA): modelos pela API
# de cada provedor com chave + preços do catálogo público LiteLLM. true = verifica
# todo dia às 03:40 (precisa do agendador e da fila). Preço editado à mão no
# painel fica travado. "Sincronizar agora" funciona mesmo com false.
AI_CATALOG_SYNC_ENABLED=false
# AI_PRICES_CATALOG_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json

# Opcionais — já têm padrão em config/ai.php; só defina para mudar.
# <PROVEDOR> = OPENAI, ANTHROPIC, GEMINI, MISTRAL, GROQ, XAI, AZURE_OPENAI,
#              MARITACA (padrão sabia-4-br-sp: processa 100% no Brasil).
# AI_HTTP_FORCE_IPV4=true            # hospedagem com IPv6 anunciado sem rota de saída
# AI_<PROVEDOR>_MODEL=...            # modelo usado só se o painel não tiver escolhido
# AI_<PROVEDOR>_BASE_URL=...         # proxy/endpoint alternativo (sempre HTTPS)
# AI_<PROVEDOR>_TIMEOUT_SECONDS=20   # idem _CONNECT_TIMEOUT_SECONDS, _RETRY_TIMES, _RETRY_SLEEP_MS
# AI_ANTHROPIC_DEFAULT_MAX_TOKENS=800
# ANTHROPIC_API_VERSION=2023-06-01

# ------------------------------------------------------------
# AUTO-ATUALIZAÇÃO DO EASYEYE INTEGRATOR
# ------------------------------------------------------------
# Chave PÚBLICA ed25519 (hex, 32 bytes) usada só pra VERIFICAR a assinatura
# de builds publicados via `php artisan integrator:publish-update` — nunca
# pra assinar. Tem default seguro em config/services.php (mesmo valor de
# UPDATE_PUBLIC_KEY_HEX embutido no binário Rust, repositório integrator/) —
# só defina aqui se rotacionar o par de chaves de release.
# INTEGRATOR_UPDATE_PUBLIC_KEY=

# Pricing — converte custo bruto do provider em créditos EasyEye.
# usd_per_credit: quanto 1 crédito representa em USD.
# margin_multiplier: absorve risco de variação cambial e margem do produto.
# minimum_credits_*: piso por execução (evita surpresas com prompts curtos).
AI_USD_PER_CREDIT=0.01
AI_CREDIT_MARGIN_MULTIPLIER=2.0
AI_MIN_CREDITS_DEFAULT=1
AI_MIN_CREDITS_EXAM_ASSISTANT=3
AI_MIN_CREDITS_REPORT_DRAFTING=2
AI_MIN_CREDITS_CONSENSUS_REVIEW=5

# Compra avulsa de créditos IA: paga pelo checkout (Minha assinatura) e
# creditada só quando o gateway confirma. AI_CREDIT_PURCHASES_AUTO_CREDIT foi
# removida (obsoleta, junto com o endpoint antigo de compra).
AI_CREDIT_PURCHASE_CURRENCY=BRL
# Pedido de pacote pendente sem pagamento é descartado depois de N dias
# (ai:expire-credit-pack-orders, diário).
AI_CREDIT_PACK_PENDING_EXPIRY_DAYS=7

# Configuração de fila/job para RunAiWorkflowJob.
AI_QUEUE=default
AI_JOB_TRIES=3
AI_JOB_BACKOFF_SECONDS=45
AI_JOB_TIMEOUT_SECONDS=180

# Circuit breaker dos providers LLM (Fase 7).
# threshold = falhas consecutivas antes de abrir; cooldown = quanto tempo fica aberto.
AI_BREAKER_THRESHOLD=5
AI_BREAKER_COOLDOWN_SECONDS=120

# Rate limit por (user_id + entity_id) nas rotas AI (Fase 7).
AI_RATE_ESTIMATE_PER_MIN=60
AI_RATE_STORE_PER_MIN=10
AI_RATE_DECISION_PER_MIN=30

# Documentação Swagger da API de integradores (/docs/api)
# Vazio = rotas respondem 404 (doc desabilitada)
DOCS_API_PASSWORD=

# ------------------------------------------------------------
# WhatsApp oficial (API da Meta) via Gupshup — docs/integracoes/whatsapp-gupshup.md
# gupshup = envia de verdade · mock (ou vazio) = só simula e registra em log
WHATSAPP_DRIVER=mock
# Credenciais do PARCEIRO EasyEye na Gupshup (só aqui, nunca no banco).
# Recomendado: token universal gerado no portal de parceiros (Settings →
# Universal Token Management; vale até 60 dias — rotacione antes de vencer).
GUPSHUP_UNIVERSAL_TOKEN=
# Validade do token universal (AAAA-MM-DD; opcional — sem ela o sistema lê o
# "exp" do próprio token). O manager avisa N dias antes de vencer.
GUPSHUP_UNIVERSAL_TOKEN_EXPIRES_AT=
GUPSHUP_UNIVERSAL_TOKEN_WARN_DAYS=10
# Validade (h) do token de app gerado com o universal: 2 a 24 (máx. 3 ativos por app)
GUPSHUP_APP_TOKEN_HOURS=6
# Alternativa (token de app antigo, deixa de funcionar em 01/04/2027):
# e-mail do parceiro + client secret (Settings → API client details).
GUPSHUP_PARTNER_EMAIL=
GUPSHUP_PARTNER_SECRET=
# Vazio escolhe sozinho (universal quando há GUPSHUP_UNIVERSAL_TOKEN): universal | partner_token
GUPSHUP_AUTH_MODE=
# Idiomas com os templates aprovados na Meta (pt_BR; acrescente ,en quando aprovar os em inglês)
WHATSAPP_TEMPLATE_LANGUAGES=pt_BR
# Fila dos envios: fila diferente de "default" precisa entrar no worker (--queue=whatsapp,default)
WHATSAPP_QUEUE=default
# Limite do webhook por token da URL (chamadas/minuto por app)
WHATSAPP_WEBHOOK_RATE_LIMIT=1200
# Limite GLOBAL para token de URL inexistente (chamadas/minuto, todos juntos)
WHATSAPP_WEBHOOK_UNKNOWN_RATE_LIMIT=60
# Validade (s) do lock de geração do token do app — mínimo 120
GUPSHUP_TOKEN_LOCK_SECONDS=120
# Mensagem presa em "sending" há mais que isso (min) vira falha
# unknown_delivery + alerta (whatsapp:sweep-stuck, a cada 10 min)
WHATSAPP_SENDING_STUCK_MINUTES=15
# Driver mock: exigir o código de verificação do cadastro (que só aparece no
# log)? Só faz sentido em testes automatizados (phpunit.xml liga). Em
# APP_ENV=local o mock já exige; homologação/produção com mock: o gate libera.
WHATSAPP_MOCK_REQUIRES_CODE=false

# ------------------------------------------------------------
# Tempo real (WebSocket) — Laravel Reverb
# Progresso das importações (pacientes, médicos, agenda, medicamentos) chega
# ao navegador por aqui, sem polling HTTP. Gere credenciais com
# `php artisan reverb:install`. REVERB_HOST/PORT = onde o NAVEGADOR e o app
# alcançam o servidor (em produção, o domínio público via proxy em 443);
# REVERB_SERVER_HOST/PORT = onde o processo `reverb:start` escuta.
# Escala horizontal: REVERB_SCALING_ENABLED=true usa o Redis padrão (pub/sub).
# ------------------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ------------------------------------------------------------
# ANS — Operadoras de Saúde
# ------------------------------------------------------------
ANS_OPERATORS_SYNC_ENABLED=true
ANS_PLANS_SYNC_ENABLED=true
